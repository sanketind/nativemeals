# Copy into the site settings. Leave a value empty until it is real.
# Do not commit a filled-in .env file.

# Public site URL, used for links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content value from the Google Search Console HTML-tag method.
# Leave empty until the live domain is verified. No meta tag is printed when empty.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Phone shown as a click-to-call link. Example: +9198XXXXXXX
NEXT_PUBLIC_PHONE=

# WhatsApp number with country code, digits only. Example: 9198XXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact email. Also used as a fallback when the enquiry form cannot be delivered.
NEXT_PUBLIC_EMAIL=

# Where enquiry forms are forwarded. POST JSON. A private Google Sheet web app URL,
# from scripts/enquiry-to-sheet.gs. Leave empty to fall back to WhatsApp.
ENQUIRY_WEBHOOK_URL=

# Google Sheet "Publish to web" CSV link for the weekly menu.
# Leave empty to show the built-in sample week.
WEEKLY_MENU_CSV_URL=

# Secret for the bookmark that publishes the menu immediately.
# Link: /api/revalidate?secret=this-value
REVALIDATE_SECRET=

# FSSAI licence number. Shown on the site only when set. Example: 12345678901234
NEXT_PUBLIC_FSSAI=

# Neighbourhood of the kitchen. Example: Wakad
NEXT_PUBLIC_KITCHEN_LOCALITY=

# Delivery clock times, as you want them printed. Example: 7–9 am
NEXT_PUBLIC_BREAKFAST_BY=
NEXT_PUBLIC_LUNCH_BY=
NEXT_PUBLIC_DINNER_BY=

# Cutoff for skipping a meal. Example: 9:00 pm the evening before
NEXT_PUBLIC_SKIP_CUTOFF=
